{
  "name": "folio-books",
  "version": "1.10.5",
  "private": true,
  "type": "module",
  "scripts": {
    "test:epub": "FOLIO_EPUB_ONLY=1 node tests/browser.mjs",
    "test:ipad-fixes": "FOLIO_V19_ONLY=1 node tests/browser.mjs",
    "test:fixes": "FOLIO_V18_ONLY=1 node tests/browser.mjs",
    "test:reading": "FOLIO_V17_ONLY=1 node tests/browser.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/package.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/core.test.mjs tests/export.test.mjs tests/book-package.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:reliability": "FOLIO_RELIABILITY_ONLY=1 node tests/browser.mjs",
    "test:ipad": "FOLIO_IPAD_ONLY=1 node tests/browser.mjs",
    "test:appearance": "FOLIO_APPEARANCE_ONLY=1 node tests/browser.mjs",
    "test:experience": "FOLIO_V16_ONLY=1 node tests/browser.mjs",
    "test:reader": "FOLIO_READER_V15_ONLY=1 node tests/browser.mjs",
    "test:transfer": "FOLIO_TRANSFER_ONLY=1 node tests/browser.mjs",
    "test:pages": "node tests/pages.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "lucide": "0.468.0",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "^7.1.0"
  }
}
